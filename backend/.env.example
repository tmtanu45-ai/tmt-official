# TMT Esports Backend Environment Variables
# COPY THIS FILE TO .env AND FILL IN ALL VALUES
# NEVER COMMIT .env TO VERSION CONTROL

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ============================================
# SUPABASE - DB-AUTH (Org 1)
# ============================================
SUPABASE_AUTH_URL=https://your-project.supabase.co
SUPABASE_AUTH_ANON_KEY=your-anon-key
SUPABASE_AUTH_SERVICE_KEY=your-service-role-key

# ============================================
# SUPABASE - DB-MATCH (Org 1)
# ============================================
SUPABASE_MATCH_URL=https://your-project.supabase.co
SUPABASE_MATCH_ANON_KEY=your-anon-key
SUPABASE_MATCH_SERVICE_KEY=your-service-role-key

# ============================================
# SUPABASE - DB-CRED (Org 2) - HIGH SECURITY
# ============================================
SUPABASE_CRED_URL=https://your-project.supabase.co
SUPABASE_CRED_ANON_KEY=your-anon-key
SUPABASE_CRED_SERVICE_KEY=your-service-role-key

# ============================================
# SUPABASE - DB-AUDIT (Org 2)
# ============================================
SUPABASE_AUDIT_URL=https://your-project.supabase.co
SUPABASE_AUDIT_ANON_KEY=your-anon-key
SUPABASE_AUDIT_SERVICE_KEY=your-service-role-key

# ============================================
# SUPABASE - DB-NOTIF (Org 3)
# ============================================
SUPABASE_NOTIF_URL=https://your-project.supabase.co
SUPABASE_NOTIF_ANON_KEY=your-anon-key
SUPABASE_NOTIF_SERVICE_KEY=your-service-role-key

# ============================================
# ENCRYPTION (CRITICAL - GENERATE ONCE)
# ============================================
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# ============================================
# EMAIL (Cloudflare Worker)
# ============================================
EMAIL_WORKER_URL=https://your-worker.your-subdomain.workers.dev
EMAIL_API_TOKEN=

# ============================================
# RATE LIMITING (Upstash Redis)
# ============================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# CRON & ADMIN SECURITY
# ============================================
# Generate with: openssl rand -base64 32
CRON_SECRET=
ADMIN_API_SECRET=

# ============================================
# GOOGLE DRIVE BACKUP
# ============================================
GDRIVE_SA1_KEY_FILE=./sa1.json
GDRIVE_SA2_KEY_FILE=./sa2.json
GDRIVE_SA3_KEY_FILE=./sa3.json
AGE_PUBLIC_KEY=age1...

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs