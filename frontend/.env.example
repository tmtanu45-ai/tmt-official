# Frontend Environment Variables
# Copy to .env.local and fill in values

# API
VITE_API_URL=http://localhost:3000/api/v1

# Supabase (Public anon keys only - safe for frontend)
VITE_SUPABASE_AUTH_URL=https://your-project.supabase.co
VITE_SUPABASE_AUTH_ANON_KEY=your-anon-key
VITE_SUPABASE_MATCH_URL=https://your-project.supabase.co
VITE_SUPABASE_MATCH_ANON_KEY=your-anon-key

# App
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=TMT OFFICIAL eSports